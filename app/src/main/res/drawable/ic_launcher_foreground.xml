<?xml version="1.0" encoding="utf-8"?>
<!-- Spark brand mark: a clean azure lightning bolt over a mesh node, on obsidian. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- soft radial glow behind mark -->
    <path
        android:pathData="M54,54m-34,0a34,34 0,1 1,68 0a34,34 0,1 1,-68 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="34"
                >
                <item android:color="#334D7CFF" android:offset="0.0" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- mesh nodes (subtle, dim) -->
    <path android:fillColor="#2A4D7CFF"
        android:pathData="M30,36m-3.4,0a3.4,3.4 0,1 1,6.8 0a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#2A4D7CFF"
        android:pathData="M78,36m-3.4,0a3.4,3.4 0,1 1,6.8 0a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#2A4D7CFF"
        android:pathData="M30,74m-3.4,0a3.4,3.4 0,1 1,6.8 0a3.4,3.4 0,1 1,-6.8 0" />
    <path android:fillColor="#2A4D7CFF"
        android:pathData="M78,74m-3.4,0a3.4,3.4 0,1 1,6.8 0a3.4,3.4 0,1 1,-6.8 0" />

    <!-- connecting lines -->
    <path android:strokeColor="#3379A0FF" android:strokeWidth="1.4"
        android:pathData="M30,36 L78,74 M78,36 L30,74" />

    <!-- the spark bolt -->
    <path
        android:pathData="M59.5,30 L39,58 L51,58 L47,78 L68,49 L56,49 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="40"
                android:startY="30"
                android:endX="68"
                android:endY="78"
                android:type="linear">
                <item android:color="#FF79A0FF" android:offset="0.0" />
                <item android:color="#FF4D7CFF" android:offset="0.55" />
                <item android:color="#FF3FC8F5" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
