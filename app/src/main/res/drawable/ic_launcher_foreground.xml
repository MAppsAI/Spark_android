<?xml version="1.0" encoding="utf-8"?>
<!-- Spark brand mark v2: glowing azure bolt over a crisp mesh, on obsidian. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- wide bloom behind the bolt -->
    <path
        android:pathData="M54,54m-40,0a40,40 0,1 1,80 0a40,40 0,1 1,-80 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="54"
                android:gradientRadius="40">
                <item android:color="#4D3FC8F5" android:offset="0.0" />
                <item android:color="#264D7CFF" android:offset="0.45" />
                <item android:color="#00000000" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- mesh nodes -->
    <path android:fillColor="#66A8C8FF"
        android:pathData="M30,36m-3.8,0a3.8,3.8 0,1 1,7.6 0a3.8,3.8 0,1 1,-7.6 0" />
    <path android:fillColor="#66A8C8FF"
        android:pathData="M78,36m-3.8,0a3.8,3.8 0,1 1,7.6 0a3.8,3.8 0,1 1,-7.6 0" />
    <path android:fillColor="#66A8C8FF"
        android:pathData="M30,74m-3.8,0a3.8,3.8 0,1 1,7.6 0a3.8,3.8 0,1 1,-7.6 0" />
    <path android:fillColor="#66A8C8FF"
        android:pathData="M78,74m-3.8,0a3.8,3.8 0,1 1,7.6 0a3.8,3.8 0,1 1,-7.6 0" />

    <!-- connecting lines: crisper weight -->
    <path android:strokeColor="#80B8D4FF" android:strokeWidth="2.2"
        android:pathData="M30,36 L78,74 M78,36 L30,74" />

    <!-- soft halo behind bolt (slightly larger, low alpha) -->
    <path android:fillColor="#333FC8F5"
        android:pathData="M61,27 L37,58.5 L49.5,58.5 L44.5,81 L71.5,47.5 L58,47.5 Z" />

    <!-- the spark bolt — tightened silhouette, symmetric facets -->
    <path
        android:pathData="M59.5,30 L39,58 L51,58 L47,78 L68,49 L56,49 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="42"
                android:startY="30"
                android:endX="66"
                android:endY="78"
                android:type="linear">
                <item android:color="#FF9FC4FF" android:offset="0.0" />
                <item android:color="#FF4D7CFF" android:offset="0.5" />
                <item android:color="#FF3FC8F5" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
